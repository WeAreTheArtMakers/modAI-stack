APP_ENV=development
POSTGRES_DB=rag_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-local-password@localhost:5432/rag_platform
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=modAIJet:latest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Runtime defaults to cache-only loading. Use the prefetch command to provision
# this model, or set EMBEDDING_MODEL=/models/<model-directory> in Docker.
EMBEDDING_CACHE_DIR=./models/cache
EMBEDDING_ALLOW_DOWNLOAD=false
ALLOW_REGISTRATION=true
REFRESH_COOKIE_NAME=modai_refresh
# Set true behind HTTPS/TLS in production. SameSite protects the cookie refresh flow.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
WEBSOCKET_TICKET_TTL_SECONDS=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RAG_PER_MINUTE=30
RATE_LIMIT_MODEL_PULL_PER_HOUR=5
# Comma-separated exact origins (for example https://console.example.com) only
# if a separate frontend origin is intentionally deployed.
TRUSTED_FRONTEND_ORIGINS=
METRICS_ENABLED=true
MODEL_DIR=./models
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RAG_TOP_K=3
MAX_CONCURRENT_LLM_REQUESTS=4
MAX_UPLOAD_BYTES=10485760
DATA_DIR=./data/modai
AUTO_CREATE_SCHEMA=false
INDEXING_JOB_TIMEOUT_SECONDS=900
INDEXING_MAX_RETRIES=3
